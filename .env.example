# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ====================================================================

# Next.js Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (Required for PostgreSQL & Auth when connecting remote DB)
# Note: Keep service role secret on server side only! Never expose to client!
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key

# Optional Future AI Coach Integration
OPENAI_API_KEY=your-optional-openai-key
GEMINI_API_KEY=your-optional-gemini-key

# Admin Master Secret Passcode (for admin panel authentication)
ADMIN_SECRET_KEY=interview_ready_admin_secure_key_2026
